# Optional host port for Docker Compose.
ASCN_HOST_PORT=3000

# Set these before exposing the dashboard to the internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_URL=

# Optional: protects POST /api/messages/send via x-api-key.
INTERNAL_API_KEY=

# Normally Telegram is connected from the dashboard; these are server-side fallbacks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
